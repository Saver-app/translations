{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glossary.schema.json",
  "title": "Glossary of product terms",
  "type": "object",
  "required": ["terms"],
  "properties": {
    "$schema": { "type": "string" },
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["term", "description"],
        "additionalProperties": false,
        "properties": {
          "term": { "type": "string", "description": "The English term." },
          "description": { "type": "string", "description": "What it means in Saver." },
          "doNotTranslate": { "type": "boolean", "description": "Kept exactly as written in every language (names)." },
          "translations": {
            "type": "object",
            "description": "The agreed translation per language code.",
            "additionalProperties": { "type": "string" }
          }
        }
      }
    }
  }
}
